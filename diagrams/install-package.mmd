flowchart TD
  command{"Command"}

  install["freight install"]
  installBuild{"--no-build?"}
  buildInstall["Run freight build<br/>selected profile/target"]
  installOutputs["Read build outputs<br/>target/profile/"]

  installTree["Copy files into install layout<br/>bin/ lib/ include/"]
  prefix["Apply --prefix<br/>example: /usr/local"]
  destdir["Optional --destdir staging root<br/>example: target/stage"]
  installed["Installed tree<br/>DESTDIR + prefix"]

  package["freight package"]
  packageBuild["Build selected package target"]
  packageOutputs["Read package outputs<br/>target/profile/"]
  stage["Create temporary package stage<br/>under target/package/"]
  stageLayout["Copy files into staged layout<br/>bin/ lib/ include/"]
  archive["Archive staged tree<br/>.tar.gz or .zip"]
  native{"--installer?"}
  installer["Native installer<br/>.deb / .dmg / .exe"]
  artifacts["Package artifacts<br/>target/package/"]

  command -- "install" --> install --> installBuild
  installBuild -- "no" --> buildInstall --> installOutputs
  installBuild -- "yes" --> installOutputs
  installOutputs --> installTree
  installTree --> prefix --> destdir --> installed

  command -- "package" --> package --> packageBuild --> packageOutputs
  packageOutputs --> stage --> stageLayout --> archive --> native
  native -- "no" --> artifacts
  native -- "yes" --> installer --> artifacts
