%%{init: {"flowchart": {"htmlLabels": false}} }%%
flowchart TD
  manifest["freight.toml"]

  subgraph active["Active edges"]
    base["[dependencies]"]
    build["[build-dependencies]"]
    dev["[dev-dependencies]"]
    features["features"]
    target["target tables"]
  end

  normalize["Normalize<br/>edges"]
  resolve["Resolve versions<br/>and features"]
  source{"Source kind"}

  registry["Registry<br/>package"]
  path["Path<br/>package"]
  giturl["Git / URL<br/>source"]
  system["System<br/>package"]

  cache[(".pkgs cache")]
  prebuilt{"Prebuilt<br/>matches?"}
  usePrebuilt["Use cached<br/>include/lib"]
  buildSource["Build from<br/>source"]
  final["Build flags<br/>and libs"]

  manifest --> active
  active --> normalize --> resolve --> source
  source -- "registry" --> registry --> cache
  source -- "path" --> path --> buildSource
  source -- "git/url" --> giturl --> cache
  source -- "system" --> system --> final
  cache --> prebuilt
  prebuilt -- "yes" --> usePrebuilt --> final
  prebuilt -- "no" --> buildSource --> final
