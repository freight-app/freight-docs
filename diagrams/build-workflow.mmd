flowchart TD
  start["freight build"]
  manifest["Find project<br/>read freight.toml"]
  config["Resolve build settings<br/>profile + target + features"]
  depGraph["Resolve dependency graph"]
  fetch["Fetch missing packages"]
  depbuild{"Dependency has<br/>compatible prebuilt?"}
  sourceDeps["Build source deps<br/>target/deps/name"]
  compileDb["Write clangd database<br/>.freight/lsp/profile/compile_commands.json"]
  sources["Discover package targets<br/>lib + bins + tests + modules"]
  compile["Compile translation units"]
  link["Link libraries and executables"]
  outputs["Build outputs<br/>target/profile/"]
  followup["freight test / run / install<br/>use built outputs"]

  pkgs[(".pkgs/name<br/>download cache")]

  start --> manifest --> config --> depGraph --> fetch --> pkgs --> depbuild
  depbuild -- "yes" --> sources
  depbuild -- "no" --> sourceDeps --> sources
  sources --> compileDb
  sources --> compile --> link --> outputs --> followup
