flowchart TD
  author["Package author"]
  verify["Verify locally<br/>freight test + freight package"]
  login["freight login<br/>registry token"]
  publish["freight publish"]
  bundle["Create upload bundle<br/>manifest + source archive + README/docs + optional prebuilts"]

  validate["Registry validates<br/>auth + ownership + version"]
  store["Store package version"]

  subgraph stored["Registry records"]
    metadata["Manifest metadata<br/>deps/features/targets"]
    source["Source archive"]
    docs["README and docs index"]
    prebuilts["Prebuilt archives<br/>by target triple"]
  end

  consumer["Consumer project<br/>freight fetch/build"]
  choose{"Compatible prebuilt<br/>available?"}
  downloadPrebuilt["Download prebuilt<br/>to .pkgs/name"]
  downloadSource["Download source<br/>to .pkgs/name"]
  buildSource["Build source dependency<br/>target/deps/name"]
  compile["Compile consumer package"]

  author --> verify --> login --> publish --> bundle --> validate --> store
  store --> metadata
  store --> source
  store --> docs
  store --> prebuilts
  metadata --> consumer --> choose
  choose -- "yes" --> prebuilts --> downloadPrebuilt --> compile
  choose -- "no" --> source --> downloadSource --> buildSource --> compile
